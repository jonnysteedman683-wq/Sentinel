{
  "name": "arcane-quantum-brain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint:biome": "biome lint src server.ts",
    "format": "biome format --write src server.ts",
    "format:check": "biome format src server.ts",
    "check": "biome check src server.ts",
    "test": "vitest run --globals --environment jsdom",
    "test:watch": "vitest --globals --environment jsdom",
    "test:coverage": "vitest run --coverage --globals --environment jsdom",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@xstate/react": "^6.1.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "12.17.1",
    "firebase-admin": "^14.2.0",
    "force-graph": "^1.51.4",
    "groq-sdk": "^1.5.0",
    "isolated-vm": "^6.1.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "node-cron": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-firebase-hooks": "^5.1.1",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
