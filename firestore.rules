rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/memories/{docId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /users/{userId}/memoriesArchive/{docId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /users/{userId}/wisdom/{docId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /users/{userId}/systemHealth/eventLog/{docId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
